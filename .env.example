NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thecountryfloor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thecountryfloor
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thecountryfloor.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local emulators (leave false / unset for production deploys)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Required to wipe+seed the real Firebase project (never set in App Hosting)
# ALLOW_LIVE_SEED=true
# GOOGLE_APPLICATION_CREDENTIALS=./your-adminsdk.json
